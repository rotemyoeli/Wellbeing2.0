# ============================================================================
# wellbeing-app — Environment Variables (example)
# ============================================================================
# Copy this file to `.env` (in the project root) and fill in real values.
# Never commit `.env` (it's in .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# CORE
# ----------------------------------------------------------------------------

# Flask environment: "development", "testing", or "production"
# Affects logging level, CORS strictness, and DEV_MODE-bypass eligibility.
FLASK_ENV=development

# Application secret key — used by Flask sessions, CSRF tokens.
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-not-for-prod-replace-me

# JWT signing key — used by Flask-JWT-Extended.
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-jwt-secret-not-for-prod-replace-me

# JWT access token TTL (seconds). Spec v2 NFR-SEC-02: refresh every 15 min.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# ----------------------------------------------------------------------------
# DEV MODE BACKDOOR — REMOVE BEFORE PRODUCTION
# ----------------------------------------------------------------------------

# When true:
#   - All API endpoints bypass auth
#   - Every request is treated as having admin role
#   - A warning banner is logged on app boot
#   - Responses include header X-Dev-Mode: ON
# In production, this MUST be unset or "false".
WELLBEING_DEV_MODE=true

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------

# SQLite for dev (default), PostgreSQL for staging/prod.
# Examples:
#   SQLite:     sqlite:///dev.db
#   Postgres:   postgresql://user:pass@localhost:5432/wellbeing
#   Postgres on Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///dev.db

# ----------------------------------------------------------------------------
# ANONYMITY (CRITICAL — see Spec v2 §8 and the architectural anonymity UVP)
# ----------------------------------------------------------------------------

# The salt used in the one-way anon_token hash:
#   anon_token = blake2b(user_id || date || ANON_TOKEN_SALT)
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotate periodically (every 6-12 months) — note the rotation event in the audit log.
# DO NOT commit a real production salt to git.
ANON_TOKEN_SALT=dev-salt-not-for-prod-replace-me

# Comment field encryption key (AES-256-GCM, see Spec v2 §8.2).
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In Sprint 1 the encryption layer is a stub; in Sprint 4 it activates.
COMMENT_ENCRYPTION_KEY=dev-encryption-key-not-for-prod-replace-me

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# In dev, the local Vite dev server URL.
# In production, the deployed frontend URL.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ----------------------------------------------------------------------------
# RATE LIMITING (Spec v2 NFR-SEC-04: <=60 req/min per user)
# ----------------------------------------------------------------------------

# Sprint 1: not enforced. Sprint 2+: read by middleware.
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------

# Host and port for the Flask dev server.
HOST=127.0.0.1
PORT=5000

# ----------------------------------------------------------------------------
# NOTIFICATION CHANNELS (Sprint 4+)
# ----------------------------------------------------------------------------

# Email (Resend) — placeholder, filled when integration starts
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS (Twilio) — placeholder
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp (360dialog) — placeholder, requires opt-in + Meta-approved templates
WA_360DIALOG_API_KEY=
WA_360DIALOG_NUMBER=

# Push (VAPID for Web Push) — placeholder, generate with: web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.org

# ----------------------------------------------------------------------------
# OBSERVABILITY (Sprint 4+)
# ----------------------------------------------------------------------------

# Sentry DSN for error reporting. Empty = disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------

# Default anonymity policy for the ward — managed by Admin in real product;
# this env var seeds the default until Admin UI exists.
# Values: "always_anonymous", "always_identified", "user_choice"
DEFAULT_ANONYMITY_POLICY=user_choice

# Aggregation threshold (Spec v2 §6 FR-05).
# Below this value, only ward-level aggregate data is shown.
AGGREGATION_THRESHOLD=5

# Alert thresholds (Spec v2 §6 FR-06; Admin-configurable in real product)
ALERT_THRESHOLD_LOW=25
ALERT_THRESHOLD_HIGH=85
